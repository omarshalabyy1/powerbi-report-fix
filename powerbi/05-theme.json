{
  "name": "Report fix",
  "dataColors": ["#2563EB", "#0E1630", "#94A3B8", "#60A5FA", "#1E3A8A", "#CBD5E1", "#3B82F6", "#475569"],
  "background": "#FFFFFF",
  "foreground": "#0E1630",
  "tableAccent": "#2563EB",
  "good": "#16A34A",
  "neutral": "#94A3B8",
  "bad": "#DC2626",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#0E1630" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0E1630" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0E1630" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#475569" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F7FB" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 8 }]
      }
    }
  }
}
